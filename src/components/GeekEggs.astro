---
/* A quiet, opt-in nod to the original terminal theme. */
---
<div id="crt-overlay" aria-hidden="true"></div>
<style is:global>
  #crt-overlay { display: none; pointer-events: none; position: fixed; inset: 0; z-index: 50; }
  html.crt #crt-overlay { display: block; background: repeating-linear-gradient(0deg, #00000018 0px, #00000018 1px, transparent 1px, transparent 4px); }
  @media (prefers-reduced-motion: reduce) { #crt-overlay { display: none !important; } }
</style>
<script>
  const sequence = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
  let position = 0;
  window.addEventListener('keydown', event => {
    const target = event.target;
    if (target instanceof HTMLElement && (target.isContentEditable || target.closest('input, textarea, select, dialog[open]'))) return;
    const key = event.key.length === 1 ? event.key.toLowerCase() : event.key;
    position = key === sequence[position] ? position + 1 : Number(key === sequence[0]);
    if (position === sequence.length) { position = 0; document.documentElement.classList.toggle('crt'); }
  });
</script>
