---
import ProjectImage from './ProjectImage.astro';
import type { Project } from '../data/projects';
interface Props { project: Project; showFeatures?: boolean; }
const { project, showFeatures = false } = Astro.props;
---
<div class="project-details">
  <div class="project-detail-intro">
    <div><p>{project.detailedDescription || project.description}</p><div class="project-links">
      {project.github && <a href={project.github} target="_blank" rel="noopener noreferrer" class="button button-primary">View source on GitHub <span aria-hidden="true">↗</span></a>}
      {project.demo && <a href={project.demo} target="_blank" rel="noopener noreferrer" class="button button-quiet">Demo ↗</a>}
      {project.docs && <a href={project.docs} target="_blank" rel="noopener noreferrer" class="button button-quiet">Documentation ↗</a>}
    </div></div>
    <div><p class="eyebrow">TECHNOLOGIES</p><div class="tags" style="margin-top: 15px">{project.tech.map(tech => <span class="tag">{tech}</span>)}</div></div>
  </div>
  {showFeatures && project.features && <section class="project-detail-section" aria-labelledby="features-title"><div class="detail-section-heading"><span>01</span><h2 id="features-title">What it does</h2></div><ul class="feature-list">{project.features.map(feature => <li>{feature}</li>)}</ul></section>}
  {showFeatures && project.gallery?.length && <section class="project-detail-section" aria-labelledby="hardware-title">
    <div class="detail-section-heading"><span>02</span><h2 id="hardware-title">On the workbench</h2></div><p class="gallery-hint">Open a photo to inspect the full-resolution hardware.</p>
    <div class="hardware-gallery">{project.gallery.map(photo => <figure><a href={photo.src} target="_blank" rel="noopener noreferrer" class="gallery-image" aria-label={`Open full-resolution photo: ${photo.caption}`}><ProjectImage src={photo.src} alt={photo.caption} detail /></a><figcaption>{photo.caption}</figcaption></figure>)}</div>
  </section>}
  {showFeatures && project.systemDiagram && <section class="project-detail-section" aria-labelledby="diagram-title"><div class="detail-section-heading"><span>03</span><h2 id="diagram-title">How it connects</h2></div><p class="gallery-hint" id="diagram-help">System block diagram. Scroll horizontally to explore the full layout.</p><pre class="diagram" tabindex="0" role="region" aria-label="System block diagram" aria-describedby="diagram-help">{project.systemDiagram.trimEnd()}</pre></section>}
</div>
