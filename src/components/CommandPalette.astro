---
import { projects } from '../data/projects';
import { getCollection } from 'astro:content';
const posts = await getCollection('blog');
const pages = [
  { label: 'Home', hint: 'Start here', href: '/' },
  { label: 'Projects', hint: 'The workbench', href: '/projects' },
  ...projects.map(project => ({ label: project.title, hint: project.tech.join(' / '), href: `/projects/${project.slug}` })),
  { label: 'Journal', hint: 'Field notes', href: '/blog' },
  ...posts.map(post => ({ label: post.data.title, hint: 'Journal article', href: `/blog/${post.id}` })),
  { label: 'About', hint: 'Get in touch', href: '/about' },
];
---
<dialog id="palette" class="command-dialog" aria-labelledby="palette-title">
  <div class="dialog-heading"><h2 id="palette-title">Find your way.</h2><button type="button" class="dialog-close" data-close-palette aria-label="Close search">Esc</button></div>
  <label class="search-field"><span aria-hidden="true">⌕</span><span class="sr-only">Search pages and projects</span><input id="palette-in" type="search" autocomplete="off" spellcheck="false" placeholder="Search projects, articles, pages…" role="combobox" aria-expanded="true" aria-controls="palette-list" aria-autocomplete="list" /></label>
  <ul id="palette-list" class="search-results" role="listbox" aria-label="Search results">
    {pages.map((page, index) => <li role="presentation"><a id={`search-result-${index}`} class="search-result" href={page.href} role="option" tabindex="-1" aria-selected="false" data-search={`${page.label} ${page.hint}`.toLowerCase()}><span>{page.label}</span><small>{page.hint}</small></a></li>)}
  </ul>
  <p id="palette-empty" class="search-empty" hidden>No matches. Try “ECG”, “FPGA”, or “About”.</p>
  <p class="sr-only" id="palette-status" role="status"></p>
  <div class="search-footer"><span><kbd>↑</kbd> <kbd>↓</kbd> to navigate</span><span><kbd>Enter</kbd> to open</span><span><kbd>Esc</kbd> to close</span></div>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#palette')!;
  const input = document.querySelector<HTMLInputElement>('#palette-in')!;
  const options = [...dialog.querySelectorAll<HTMLAnchorElement>('[data-search]')];
  const empty = document.querySelector<HTMLElement>('#palette-empty')!;
  const status = document.querySelector<HTMLElement>('#palette-status')!;
  let filtered = options;
  let selected = 0;
  let previousFocus: HTMLElement | null = null;
  let previousOverflow = '';
  const triggers = document.querySelectorAll<HTMLButtonElement>('[data-open-palette]');

  function updateSelection() {
    options.forEach(option => option.setAttribute('aria-selected', String(option === filtered[selected])));
    const active = filtered[selected];
    if (active) {
      input.setAttribute('aria-activedescendant', active.id);
      active.scrollIntoView({ block: 'nearest' });
    } else input.removeAttribute('aria-activedescendant');
  }
  function filter() {
    const query = input.value.trim().toLowerCase();
    filtered = options.filter(option => option.dataset.search?.includes(query));
    options.forEach(option => { option.parentElement!.hidden = !filtered.includes(option); });
    selected = 0;
    empty.hidden = filtered.length > 0;
    status.textContent = `${filtered.length} results`;
    updateSelection();
  }
  function open() {
    if (dialog.open) return;
    const mobileMenu = document.querySelector<HTMLDetailsElement>('#mobile-nav');
    if (mobileMenu) mobileMenu.open = false;
    previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    previousOverflow = document.body.style.overflow;
    document.body.style.overflow = 'hidden';
    dialog.showModal();
    input.value = '';
    filter();
    input.focus();
  }
  function close() { dialog.close(); }
  triggers.forEach(trigger => {
    trigger.hidden = false;
    const shortcut = trigger.querySelector('kbd');
    if (shortcut && !/Mac|iPhone|iPad/.test(navigator.platform)) shortcut.textContent = 'Ctrl K';
    trigger.addEventListener('click', open);
  });
  dialog.querySelector('[data-close-palette]')?.addEventListener('click', close);
  dialog.addEventListener('keydown', event => {
    if (event.key === 'Escape') { event.preventDefault(); close(); }
  });
  dialog.addEventListener('close', () => {
    document.body.style.overflow = previousOverflow;
    previousFocus?.focus();
  });
  dialog.addEventListener('click', event => {
    if (event.target !== dialog) return;
    const box = dialog.getBoundingClientRect();
    if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) close();
  });
  input.addEventListener('input', filter);
  input.addEventListener('keydown', event => {
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      if (filtered.length) selected = (selected + (event.key === 'ArrowDown' ? 1 : -1) + filtered.length) % filtered.length;
      updateSelection();
    } else if (event.key === 'Enter') {
      event.preventDefault();
      filtered[selected]?.click();
    }
  });
  document.addEventListener('keydown', event => {
    const target = event.target;
    const editing = target instanceof HTMLElement && (target.isContentEditable || !!target.closest('input, textarea, select, [role="textbox"]'));
    const shortcut = (event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k';
    const slash = event.key === '/' && !editing && !event.ctrlKey && !event.metaKey && !event.altKey;
    if (shortcut || (slash && !dialog.open)) {
      event.preventDefault();
      dialog.open ? close() : open();
    }
  });
</script>
