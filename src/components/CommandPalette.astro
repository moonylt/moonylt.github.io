---
/**
 * Ctrl+K command palette (VS Code style quick nav).
 * Open: Ctrl+K or "/" (when not typing). Arrow keys + Enter, Esc closes.
 * Actions expose window.__geek from GeekEggs (matrix / CRT toggle).
 */
---
<div id="palette" class="hidden fixed inset-0 z-[9997]">
  <div class="absolute inset-0 bg-black/60" data-palette-close></div>
  <div class="absolute left-1/2 -translate-x-1/2 top-[12vh] w-[92vw] max-w-xl rounded border border-border bg-bg-secondary shadow-2xl overflow-hidden">
    <div class="flex items-center gap-2 px-3 py-2 border-b border-border">
      <span class="text-accent font-mono text-sm">›</span>
      <input
        id="palette-in"
        type="text"
        autocomplete="off"
        spellcheck="false"
        placeholder="jump to… (projects, blog, matrix, crt)"
        class="flex-1 bg-transparent outline-none text-text-primary font-mono text-sm caret-[#4dd0e1]"
      />
      <span class="text-text-muted text-[10px] font-mono border border-border rounded px-1">esc</span>
    </div>
    <ul id="palette-list" class="max-h-[50vh] overflow-y-auto py-1 font-mono text-sm"></ul>
  </div>
</div>

<script>
  type Item = { label: string; hint: string; action: () => void };

  const overlay = document.getElementById('palette') as HTMLDivElement;
  const inputEl = document.getElementById('palette-in') as HTMLInputElement;
  const listEl = document.getElementById('palette-list') as HTMLUListElement;

  const go = (url: string) => { window.location.href = url; };

  const items: Item[] = [
    { label: '~ / home',            hint: 'mainpage',  action: () => go('/') },
    { label: 'projects/',           hint: 'index',     action: () => go('/projects') },
    { label: 'projects/ecg-physio', hint: 'flagship',  action: () => go('/projects/ecg-physio') },
    { label: 'projects/video-convertor', hint: 'fpga', action: () => go('/projects/video-convertor') },
    { label: 'blog/',               hint: 'writing',   action: () => go('/blog') },
    { label: 'about',               hint: 'who am i',  action: () => go('/about') },
    { label: 'github.com/moonylt',  hint: 'external',  action: () => window.open('https://github.com/moonylt', '_blank') },
    {
      label: 'matrix rain',
      hint: 'easter egg',
      action: () => window.dispatchEvent(new CustomEvent('geek:matrix')),
    },
    {
      label: 'toggle CRT mode',
      hint: 'easter egg',
      action: () => (window as unknown as { __geek?: { toggleCrt: () => void } }).__geek?.toggleCrt(),
    },
  ];

  let filtered: Item[] = items;
  let selected = 0;

  function render() {
    listEl.innerHTML = '';
    filtered.forEach((it, i) => {
      const li = document.createElement('li');
      li.textContent = it.label;
      li.className =
        'flex justify-between px-3 py-2 cursor-pointer ' +
        (i === selected ? 'bg-[#1e2a32] text-accent' : 'text-text-primary hover:bg-[#1e2a32]/60');
      const hint = document.createElement('span');
      hint.className = 'text-text-muted text-xs';
      hint.textContent = it.hint;
      li.appendChild(hint);
      li.addEventListener('click', () => { close(); it.action(); });
      listEl.appendChild(li);
    });
  }

  function openPalette() {
    overlay.classList.remove('hidden');
    inputEl.value = '';
    filtered = items; selected = 0; render();
    setTimeout(() => inputEl.focus(), 0);
  }
  function close() { overlay.classList.add('hidden'); }

  window.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    const typing = t.tagName === 'INPUT' || t.tagName === 'TEXTAREA';
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      overlay.classList.contains('hidden') ? openPalette() : close();
    } else if (e.key === '/' && !typing && overlay.classList.contains('hidden')) {
      e.preventDefault(); openPalette();
    } else if (e.key === 'Escape' && !overlay.classList.contains('hidden')) {
      close();
    }
  });

  overlay.querySelector('[data-palette-close]')?.addEventListener('click', close);

  inputEl?.addEventListener('input', () => {
    const q = inputEl.value.toLowerCase().trim();
    filtered = q ? items.filter((it) => (it.label + ' ' + it.hint).toLowerCase().includes(q)) : items;
    selected = 0; render();
  });
  inputEl?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { selected = Math.min(selected + 1, filtered.length - 1); render(); e.preventDefault(); }
    else if (e.key === 'ArrowUp') { selected = Math.max(selected - 1, 0); render(); e.preventDefault(); }
    else if (e.key === 'Enter' && filtered[selected]) { close(); filtered[selected].action(); }
  });
</script>
