---
import type { CollectionEntry } from 'astro:content';
interface Props { posts: CollectionEntry<'blog'>[]; }
const { posts } = Astro.props;
const sortedPosts = [...posts].sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---
<div class="journal-list">
  {sortedPosts.map(post => <a href={`/blog/${post.id}`} class="journal-entry">
    <div><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit', timeZone: 'UTC' })}</time><h3>{post.data.title}</h3>{post.data.description && <p>{post.data.description}</p>}</div><span class="journal-arrow" aria-hidden="true">↗</span>
  </a>)}
</div>
