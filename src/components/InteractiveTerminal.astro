---
/**
 * Interactive mini-terminal: visitors can actually type commands.
 * Pure vanilla JS, no deps. Placed on the homepage below the hero.
 */
---
<div id="iterm" class="my-10 max-w-2xl rounded border border-border bg-bg-secondary/70 shadow-lg overflow-hidden">
  <!-- title bar -->
  <div class="flex items-center gap-2 px-3 py-2 bg-bg-secondary border-b border-border">
    <span class="w-3 h-3 rounded-full bg-[#ff5f57]"></span>
    <span class="w-3 h-3 rounded-full bg-[#febc2e]"></span>
    <span class="w-3 h-3 rounded-full bg-[#28c840]"></span>
    <span class="text-text-muted text-xs ml-2 font-mono">guest@moonylt: ~ — zsh</span>
    <span class="ml-auto text-text-muted text-xs font-mono opacity-60">try `help`</span>
  </div>

  <!-- output -->
  <div id="iterm-out" class="font-mono text-sm p-3 h-56 overflow-y-auto leading-relaxed"></div>

  <!-- input line -->
  <div class="flex items-center gap-2 px-3 pb-3 font-mono text-sm">
    <span class="text-success whitespace-nowrap">guest@moonylt:~$</span>
    <input
      id="iterm-in"
      type="text"
      autocomplete="off"
      spellcheck="false"
      placeholder="type `help` and Enter"
      class="flex-1 bg-transparent outline-none text-text-primary caret-[#4dd0e1]"
    />
  </div>
</div>

<script>
  const out = document.getElementById('iterm-out') as HTMLDivElement;
  const input = document.getElementById('iterm-in') as HTMLInputElement;
  const box = document.getElementById('iterm');

  const PROJECTS = Array.from(document.querySelectorAll('a[href^="/projects/"]'))
    .map((a) => (a.textContent || '').trim().replace(/\/$/, ''))
    .filter((v, i, arr) => v && arr.indexOf(v) === i);

  function print(text = '', cls = 'text-text-primary') {
    const div = document.createElement('div');
    div.className = cls + ' whitespace-pre-wrap break-all';
    div.textContent = text;
    out.appendChild(div);
    out.scrollTop = out.scrollHeight;
  }

  const CMDS: Record<string, () => void> = {
    help: () => {
      print('available commands:', 'text-text-muted');
      print('  help          this text');
      print('  whoami        about me');
      print('  ls            list sections');
      print('  projects      list projects');
      print('  open <name>   go to a project');
      print('  cat contact.txt');
      print('  neofetch      system info');
      print('  date          current time');
      print('  matrix        ???');
      print('  sudo          try it');
      print('  sound on|off  retro beeper');
      print('  (Ctrl+K anywhere = quick nav)');
      print('  clear         clear screen');
    },
    whoami: () => {
      print('moonylt — Embedded Developer / Hardware Engineer');
      print('building biomedical devices, FPGA tricks and rodents-safe gadgets', 'text-text-muted');
    },
    ls: () => print('projects/  blog/  about  contact.txt'),
    projects: () => {
      print(PROJECTS.map((p) => '  ' + p + '/').join('\n'));
      print('(try: open ' + (PROJECTS[0] || 'ecg-physio') + ')', 'text-text-muted');
    },
    open: undefined as unknown as () => void,
    'cat contact.txt': () => {
      print('email: yueliteng@gmail.com', 'text-highlight');
      print('github: github.com/moonylt', 'text-highlight');
    },
    date: () => print(new Date().toString()),
    uptime: () => print('site running since you opened it — time flies when blinking cursors'),
    clear: () => (out.innerHTML = ''),
    sudo: () => {
      print('[sudo] password for guest:', 'text-text-muted');
      print('(it will be echoed — security is a meme here)', 'text-text-muted');
      awaitingPwd = true;
    },
    sound: undefined as unknown as () => void,
    exit: () => print('there is no escape. this is a static website.', 'text-text-muted'),
    hello: () => print('hello, stranger :)'),
    neofetch: () => {
      print('guest@moonylt', 'text-highlight');
      print('-----------------');
      print('OS      : Astro + Vanilla JS (static)');
      print('Host    : GitHub Pages');
      print('Kernel  : firmware v2 (protocol 0x55AA, 819200 baud)');
      print('Uptime  : ' + Math.round(performance.now() / 1000) + 's (this tab)');
      print('Shell   : fake-zsh 1.0');
      print('Board   : STM32F429 + ESP32 + 8Ch DAC');
      const mem = (performance as unknown as { memory?: { usedJSHeapSize: number } }).memory;
      print('Memory  : ' + (mem ? Math.round(mem.usedJSHeapSize / 1048576) + ' MiB JS heap' : 'n/a'));
    },
  };
  CMDS['sound'] = () => {
    const arg = (lastArgs[1] || '').toLowerCase();
    if (arg === 'on') { soundOn = true; localStorage.setItem('geek-sound', '1'); print('beep enabled. clack clack.'); }
    else if (arg === 'off') { soundOn = false; localStorage.setItem('geek-sound', '0'); print('silence.'); }
    else print('usage: sound on|off   (currently ' + (soundOn ? 'on' : 'off') + ')');
  };
  CMDS['open'] = () => {
    const arg = (lastArgs[1] || '').toLowerCase().replace(/\/$/, '');
    const match = PROJECTS.find((p) => p.toLowerCase() === arg) ||
      PROJECTS.find((p) => p.toLowerCase().includes(arg) && arg.length > 0);
    if (match) {
      print('opening ' + match + '/ ...', 'text-highlight');
      setTimeout(() => (window.location.href = '/projects/' + match.toLowerCase()), 400);
    } else {
      print('open: no such project: ' + (arg || '(none)') + ' — run `projects`', 'text-[#ff5f57]');
    }
  };

  // ---- retro beeper (WebAudio, off by default: `sound on`) ----
  let soundOn = localStorage.getItem('geek-sound') === '1';
  let ac: AudioContext | null = null;
  function beep(freq: number, ms: number) {
    if (!soundOn) return;
    try {
      ac = ac || new AudioContext();
      const o = ac.createOscillator(), g = ac.createGain();
      o.type = 'square'; o.frequency.value = freq;
      g.gain.value = 0.02;
      o.connect(g); g.connect(ac.destination);
      o.start(); o.stop(ac.currentTime + ms / 1000);
    } catch { /* autoplay policy */ }
  }

  // ---- sudo / root shell ----
  let awaitingPwd = false;
  let rootMode = false;
  const promptEl = document.querySelector('#iterm .text-success') as HTMLElement;

  function setPrompt(root: boolean) {
    if (promptEl) {
      promptEl.textContent = root ? 'root@moonylt:~#' : 'guest@moonylt:~$';
      promptEl.className = (root ? 'text-[#ff5f57]' : 'text-success') + ' whitespace-nowrap';
    }
  }
  function meltdown() {
    const junk = '0123456789ABCDEF';
    let n = 0;
    const t = setInterval(() => {
      print(Array.from({ length: 3 }, () =>
        'Killing process ' + Math.floor(Math.random() * 9999) + ' ' +
        Array.from({ length: 24 }, () => junk[Math.floor(Math.random() * 16)]).join('')), 'text-[#ff5f57]');
      if (++n > 10) {
        clearInterval(t);
        print('just kidding. static sites are immutable.', 'text-highlight');
        rootMode = false; setPrompt(false);
      }
    }, 60);
  }

  let history: string[] = [];
  let hIdx = -1;
  let lastArgs: string[] = [];

  function run(raw: string) {
    const line = raw.trim();
    beep(880, 30);
    if (!line) return;
    print((rootMode ? 'root@moonylt:~# ' : 'guest@moonylt:~$ ') + line, rootMode ? 'text-[#ff5f57]' : 'text-success');

    if (awaitingPwd) {
      awaitingPwd = false;
      if (line.length > 0) {
        rootMode = true; setPrompt(true);
        print('Access granted. root shell unlocked.', 'text-highlight');
        print('you are now god of this static site. try `rm -rf /` … or `poweroff`', 'text-text-muted');
      } else {
        print('Password incorrect.', 'text-[#ff5f57]');
      }
      return;
    }
    if (rootMode) {
      if (line === 'rm -rf /' || line.startsWith('rm -rf')) { meltdown(); return; }
      if (line === 'poweroff') {
        print('It is now safe to turn off your computer.', 'text-highlight');
        const off = document.createElement('div');
        off.className = 'fixed inset-0 z-[10001] bg-black text-[#ffb74d] font-mono flex items-center justify-center cursor-pointer';
        off.textContent = 'It is now safe to turn off your computer. (click)';
        off.addEventListener('click', () => off.remove());
        document.body.appendChild(off);
        return;
      }
      if (line === 'exit') { rootMode = false; setPrompt(false); print('back to guest.'); return; }
    }
    history.push(line);
    hIdx = history.length;
    const parts = line.split(/\s+/);
    const cmd = parts[0].toLowerCase();
    lastArgs = parts;
    if (cmd === 'matrix') {
      print('wake the rabbit...', 'text-highlight');
      window.dispatchEvent(new CustomEvent('geek:matrix'));
      return;
    }
    const fn = CMDS[cmd];
    if (fn) fn();
    else print('zsh: command not found: ' + cmd + "  — try `help`", 'text-[#ff5f57]');
  }

  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      run(input.value);
      input.value = '';
    } else if (e.key === 'ArrowUp') {
      if (hIdx > 0) { hIdx--; input.value = history[hIdx] || ''; }
      e.preventDefault();
    } else if (e.key === 'ArrowDown') {
      if (hIdx < history.length - 1) { hIdx++; input.value = history[hIdx] || ''; }
      else { hIdx = history.length; input.value = ''; }
      e.preventDefault();
    } else if (e.key === 'l' && e.ctrlKey) {
      out.innerHTML = ''; e.preventDefault();
    }
  });

  box?.addEventListener('click', () => input?.focus());

  // boot lines
  print('Last login: ' + new Date().toLocaleString(), 'text-text-muted');
  print("type `help` to see what this thing can do.", 'text-text-muted');
</script>
