    <div class="hero-actions">
      <a href="#selected-work" class="button button-primary">Explore my work <span aria-hidden="true">↗</span></a>
      <a href="/about" class="button button-quiet">A little about me <span aria-hidden="true">→</span></a>
    </div>
    <div class="hero-skills" aria-label="Technologies">{skills.map(skill => <span>{skill}</span>)}</div>
