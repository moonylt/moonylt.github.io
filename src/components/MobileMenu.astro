---
interface Props { navItems: { name: string; path: string }[]; currentPath: string; }
const { navItems, currentPath } = Astro.props;
---
<details class="mobile-nav" id="mobile-nav">
  <summary aria-label="Navigation menu">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    <span>Menu</span>
  </summary>
  <div class="mobile-nav-panel">
    {navItems.map(item => {
      const active = item.path === '/' ? currentPath === '/' : currentPath.startsWith(item.path);
      return <a href={item.path} class:list={['nav-link', { 'nav-link-active': active }]} aria-current={active ? 'page' : undefined}>{item.name}<span aria-hidden="true">↗</span></a>;
    })}
  </div>
</details>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('#mobile-nav');
  const summary = menu?.querySelector('summary');
  document.addEventListener('click', event => {
    if (event.target instanceof Node && !menu?.contains(event.target) && menu) menu.open = false;
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && menu?.open) { menu.open = false; summary?.focus(); }
  });
  menu?.addEventListener('focusout', event => {
    if (event.relatedTarget instanceof Node && !menu.contains(event.relatedTarget)) menu.open = false;
  });
  window.matchMedia('(min-width: 768px)').addEventListener('change', event => {
    if (event.matches && menu) menu.open = false;
  });
</script>
