---
import Base from '../layouts/Base.astro';
---
<Base title="About — moonylt" description="Embedded developer and hardware engineer exploring biomedical signals, FPGA systems, and firmware.">
  <header class="page-heading"><p class="eyebrow">BEHIND THE WORK / ABOUT</p><h1>A builder at heart.</h1><p>I'm moonylt, an embedded developer and hardware engineer working where the physical and digital worlds meet.</p></header>
  <div class="about-layout">
    <section class="about-story" aria-labelledby="approach-title">
      <h2 id="approach-title">From a circuit to a working system.</h2>
      <p>I'm passionate about building hardware solutions for biomedical applications and other gadgets. My focus is on creating reliable, efficient embedded systems and FPGA-based designs that solve real-world problems.</p>
      <p>My current interests include physiological signal acquisition, video processing systems, and embedded firmware development.</p>
      <a href="/projects" class="text-link">See what I'm building <span aria-hidden="true">↗</span></a>
      <div class="about-contact" id="contact"><p class="eyebrow">GET IN TOUCH</p><h2>Start a conversation.</h2><a href="mailto:yueliteng@gmail.com" class="contact-email">yueliteng@gmail.com <span aria-hidden="true">↗</span></a><div class="contact-options"><a href="https://github.com/moonylt" target="_blank" rel="noopener noreferrer" class="text-link">Find me on GitHub ↗</a><button id="copy-email" type="button" class="text-link" hidden>Copy email</button></div><p id="copy-status" role="status" class="copy-status"></p></div>
    </section>
    <aside class="expertise-panel" aria-labelledby="expertise-title">
      <p class="eyebrow">MY TOOLKIT</p><h2 id="expertise-title">Hardware × software</h2>
      <div class="tags">{['C', 'Verilog', 'Embedded', 'FPGA', 'Python', 'STM32', 'ESP32'].map(skill => <span class="tag">{skill}</span>)}</div>
      <ul class="expertise-list"><li><span>01</span><div><h3>Biomedical systems</h3><p>ECG, SpO2, temperature, and physiological signal acquisition.</p></div></li><li><span>02</span><div><h3>FPGA & video</h3><p>HDMI, VGA, scaling, and frame buffers.</p></div></li><li><span>03</span><div><h3>Embedded firmware</h3><p>Making hardware and software work together.</p></div></li><li><span>04</span><div><h3>Hardware design</h3><p>Prototyping, PCB design, and iteration.</p></div></li></ul>
    </aside>
  </div>
</Base>
<script>
  const button = document.querySelector<HTMLButtonElement>('#copy-email');
  const status = document.querySelector<HTMLElement>('#copy-status');
  if (button && navigator.clipboard) button.hidden = false;
  button?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText('yueliteng@gmail.com');
      if (status) status.textContent = 'Email copied. Ready when you are.';
    } catch {
      if (status) status.textContent = 'Copy unavailable. You can select the email address above or open it in your mail app.';
    }
  });
</script>
