---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
export async function getStaticPaths() {
  return (await getCollection('blog')).map(post => ({ params: { slug: post.id }, props: { post } }));
}
const { post }: { post: CollectionEntry<'blog'> } = Astro.props;
const { Content } = await render(post);
const dateStr = post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title={`${post.data.title} — moonylt`} description={post.data.description}>
  <article class="article-page">
    <a href="/blog" class="back-link">← Back to journal</a>
    <header class="page-heading"><p class="eyebrow">FIELD NOTES <span aria-hidden="true">/</span> <time datetime={post.data.pubDate.toISOString()}>{dateStr}</time></p><h1>{post.data.title}</h1>{post.data.description && <p>{post.data.description}</p>}</header>
    <div class="prose prose-invert article-content"><Content /></div>
    <a href="/blog" class="back-link article-back">← More from the journal</a>
  </article>
</Base>
