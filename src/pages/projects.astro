---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---
<Base title="Projects — moonylt" description="Embedded hardware, physiological signal acquisition, and FPGA video projects by moonylt.">
  <header class="page-heading"><p class="eyebrow">THE WORKBENCH / PROJECTS</p><h1>Built from curiosity.</h1><p>A collection of hardware and embedded systems projects, from physiological signals to video processing.</p></header>
  <section aria-label="Hardware projects" class="work-grid project-index">{projects.map((project, index) => <ProjectCard project={project} index={index} />)}</section>
</Base>
